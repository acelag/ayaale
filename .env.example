# Local development only. Use separate projects/values for staging and production.
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged operations. Set this only in services that need it.
SUPABASE_SECRET_KEY=
# Legacy alternative only; never set as NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Configure only for an authorized transactional email deployment.
TRANSACTIONAL_EMAIL_ENABLED=false
TRANSACTIONAL_EMAIL_FROM=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Enable newsletter signup only after approving the privacy notice and sender details.
NEWSLETTER_SIGNUP_ENABLED=false
NEWSLETTER_TEST_SEND_ENABLED=false
NEWSLETTER_SEND_ENABLED=false
# Keep this secret stable while deliveries and unsubscribe links are outstanding.
NEWSLETTER_LINK_SECRET=
NEWSLETTER_PRIVACY_VERSION=
NEWSLETTER_PRIVACY_URL=
NEWSLETTER_SENDER_DETAILS=
CRON_SECRET=

# View collection defaults to on in development. Set off for internal test sessions.
# Set on for production only after the applicable privacy review and notices.
# OFFER_VIEW_TRACKING=off

# T049: optional GA4. Leave disabled until an approved privacy notice and GA stream exist.
# Disable all Enhanced Measurement, Google Signals, ads links and user-provided data in GA first.
# Public build-time settings; rebuild after changing. Measurement ID is not a secret.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_PRIVACY_URL=

# T050: keep previews/development out of search. Enable only for an approved launch.
# Indexing also requires APP_ENV=production and NEXT_PUBLIC_SITE_URL=https://ayaale.com.
SEO_INDEXING_ENABLED=false
# Paste only the content value from Search Console's HTML verification tag (not a secret).
# Rendered only on the canonical production configuration; DNS verification is also supported.
GOOGLE_SITE_VERIFICATION=
