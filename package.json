{
  "name": "ayaale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "check:contrast": "node design/check-contrast.mjs",
    "check:deployment": "node scripts/check-deployment-env.mjs",
    "build:render": "npm run check:deployment && npm run build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:seo": "playwright test --config playwright.seo.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run check:contrast",
    "check:all": "npm run check && npm run test:db && npm run test:e2e",
    "test:db": "node --test tests/database/*.test.mjs",
    "check:recovery": "node scripts/check-recovery.mjs"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.23.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  }
}
